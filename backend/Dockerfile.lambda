# syntax=docker/dockerfile:1
#
# Imagem da API para o AWS Lambda.
#
# A base NAO e a python:3.12-slim do Dockerfile de container comum. O Lambda
# precisa do Runtime Interface Client (aws-lambda-ric), que e quem traduz a
# invocacao da plataforma em uma chamada de funcao Python. A base oficial ja o
# traz; com a slim, a imagem sobe e a funcao nao inicia.
FROM public.ecr.aws/lambda/python:3.12

WORKDIR ${LAMBDA_TASK_ROOT}

COPY pyproject.toml README.md ./
COPY app ./app

RUN pip install --no-cache-dir .

# handler = modulo.funcao, resolvido a partir de ${LAMBDA_TASK_ROOT}.
# Note a AUSENCIA do "alembic upgrade head": com varios containers podendo subir
# em paralelo, migracao no cold start seria migracao concorrente. O schema e
# responsabilidade do passo de deploy, nao da subida.
CMD ["app.lambda_handler.handler"]
