# ---------------------------------------------------------------
# Logos API - variaveis de ambiente
# Copie para .env e ajuste conforme o ambiente.
# O banco padrao roda em container: `pnpm db:up`
# ---------------------------------------------------------------

# Ambiente logico: local | staging | production
ENVIRONMENT=local

# Habilita logs de SQL e documentacao interativa.
DEBUG=false
DOCS_ENABLED=true
SQL_ECHO=false

# Nivel de log: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ---------------------------------------------------------------
# Banco de dados
#
# Padrao: PostgreSQL no container (veja compose.yaml na raiz do projeto).
#   pnpm db:up      sobe o banco
#   pnpm db:shell   abre o psql dentro do container
#
# A porta exposta no host e a 5433, e nao a 5432, porque a 5432 costuma
# estar ocupada por um PostgreSQL nativo do Windows. Dentro da rede do
# compose o banco continua na 5432, que e a mesma porta usada pela CI.
DATABASE_URL=postgresql+psycopg://logos:logos@localhost:5433/logos
#
# Alternativa sem container nenhum, para rodar em qualquer maquina:
# DATABASE_URL=sqlite:///./logos.db
# ---------------------------------------------------------------

# Origens permitidas no CORS, separadas por virgula.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------
# Teto de requisicoes por cliente (janela deslizante de 60 segundos).
#
# Leitura e escrita tem cotas diferentes: a tela de triagem lista o tempo todo,
# e a mutacao e deliberada e mais cara. O healthcheck da plataforma nao consome
# cota, senao o servico seria marcado como doente.
#
# Desligue com RATE_LIMIT_ENABLED=false para rodar teste de carga local.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_READ_PER_MINUTE=60
RATE_LIMIT_WRITE_PER_MINUTE=20

# ---------------------------------------------------------------
# Retentativa em falha transitoria de banco.
#
# Vale para leitura sempre; para escrita so quando a requisicao traz
# Idempotency-Key. POST /incidents nao e repetido internamente, porque um INSERT
# que falhou depois de um commit nao visto criaria um segundo incidente — nesse
# caso a API devolve 503 e quem reenvia e o cliente, com a mesma chave.
#
# O backoff dobra a cada tentativa (1s, 2s, 4s) e satura em 8s. O sorteio dentro
# do teto (jitter) espalha as tentativas quando o banco volta, para a reconexao
# simultanea nao derrubar o banco de novo.
#
# Tentativas conta a primeira: 3 = uma execucao mais duas repeticoes.
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY_SECONDS=1.0

# ---------------------------------------------------------------
# Disjuntor de banco (circuit breaker).
#
# Depois de N falhas transitorias consecutivas o circuito abre: as requisicoes
# seguintes falham na hora, com 503 e Retry-After, SEM tocar no banco. Isso
# libera o pool e da ao banco espaco para voltar, em vez de enfileirar
# requisicoes condenadas.
#
# Vencido o cooldown, UMA requisicao de sondagem e autorizada. Se funcionar, o
# circuito fecha; se falhar, reabre com o cooldown reiniciado. Uma sonda de cada
# vez e o ponto: liberar trafego em massa derrubaria o banco de novo.
#
# Erro de negocio (404, validacao) nao conta como falha — prova que o banco
# respondeu. O /health/live continua respondendo com o circuito aberto, para a
# plataforma nao reiniciar o servico durante uma queda de banco.
#
# Desligue com CIRCUIT_BREAKER_ENABLED=false para observar a falha crua.
CIRCUIT_BREAKER_ENABLED=true
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_COOLDOWN_SECONDS=30.0

# Cria os 120 incidentes de demonstracao quando a base esta vazia.
SEED_ON_STARTUP=true
