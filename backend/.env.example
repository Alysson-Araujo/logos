# ---------------------------------------------------------------
# Logos API - variáveis de ambiente
# Copie para .env e ajuste conforme o ambiente.
# ---------------------------------------------------------------

# Ambiente lógico: local | staging | production
ENVIRONMENT=local

# Habilita logs de SQL e documentação interativa.
DEBUG=false
DOCS_ENABLED=true
SQL_ECHO=false

# Nível de log: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# SQLite local roda sem instalar nada.
# Postgres: postgresql+psycopg://usuario:senha@localhost:5432/logos
DATABASE_URL=sqlite:///./logos.db

# Origens permitidas no CORS, separadas por vírgula.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Cria os 120 incidentes de demonstração quando a base está vazia.
SEED_ON_STARTUP=true
