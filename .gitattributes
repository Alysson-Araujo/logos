# Normaliza o fim de linha para LF em todo o repositorio.
# Sem isto, arquivos e scripts quebram na CI (Linux) quando editados no Windows.
* text=auto eol=lf

*.sh        text eol=lf
*.ps1       text eol=crlf
*.bat       text eol=crlf
*.cmd       text eol=crlf

# Binarios — nunca converter
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.webp      binary
*.ico       binary
*.pdf       binary
*.woff      binary
*.woff2     binary

# O diff de lockfile nao agrega valor na revisao
pnpm-lock.yaml  -diff
