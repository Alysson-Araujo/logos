# Base da API (sem barra final).
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Mock da API (MSW). Recomendado deixar SEM DEFINIR:
#   - sem a variavel: desenvolvimento sobe com a API simulada (a tela nunca
#     fica em branco sem o backend) e o build de producao usa a API real;
#   - true:  forca o mock em QUALQUER build, inclusive producao. Nao use
#            isso no deploy: a aplicacao passaria a exibir dados falsos;
#   - false: desliga o mock sempre.
# VITE_USE_MOCK=

# Timeout das leituras (GET) em milissegundos. Escritas usam 15s fixos.
VITE_REQUEST_TIMEOUT_MS=10000
