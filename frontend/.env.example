# Base da API (sem barra final).
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Mock da API (MSW).
#
#   - sem a variavel: o modo de desenvolvimento sobe com a API simulada, para a
#     tela nunca ficar em branco sem o backend. O build de producao usa a API
#     real de qualquer forma;
#   - true:  forca o mock em QUALQUER build, inclusive producao. Nao use isso
#            no deploy: a aplicacao passaria a exibir dados falsos;
#   - false: desliga o mock sempre.
#
# ATENCAO no fluxo de convite: com o mock ligado, criar uma conta NAO envia
# e-mail nenhum - a conta nasce dentro do navegador e nunca chega ao backend,
# embora a tela confirme o envio. Deixe `false` ao testar convite, primeiro
# acesso e envio de e-mail. Com o mock no ar, uma faixa amarela no topo da
# aplicacao avisa disso.
VITE_USE_MOCK=false

# Timeout das leituras (GET) em milissegundos. Escritas usam 15s fixos.
VITE_REQUEST_TIMEOUT_MS=10000
