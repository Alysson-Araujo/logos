  "version": "0.1.0",
  "type": "module",
  "description": "Logos — Central de Resposta a Incidentes (frontend): triagem por prioridade, ciclo de vida com lock otimista e estados de UI explícitos.",
  "engines": {
    "node": ">=20"
  },
